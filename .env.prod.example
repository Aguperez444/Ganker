# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO DE PRODUCCIÓN (gankerweb.app)
# Copiar este archivo como `.env.prod` en el servidor OCI y proteger con:
#   chmod 600 .env.prod
# ==============================================================================

# --- 1. Base de Datos PostgreSQL ---
POSTGRES_USER=ganker_prod_user
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_DE_POSTGRES
POSTGRES_DB=ganker_prod_db

# --- 2. Seguridad y Dominio ---
# Generar con: openssl rand -hex 32 (mínimo 64 caracteres hexadecimales)
JWT_SECRET_KEY=CAMBIAR_POR_OUTPUT_DE_OPENSSL_RAND_HEX_32
FRONTEND_URL=https://gankerweb.app
CORS_ORIGINS=https://gankerweb.app,https://www.gankerweb.app
# Dejar vacío para que el frontend compilado use el mismo origen (https://gankerweb.app y wss://gankerweb.app)
VITE_API_URL=

# Red interna: la IP fija de Nginx es el único proxy autorizado por Uvicorn.
# Si esta subred ya está ocupada, cambiar ambos valores manteniendo la IP dentro de la subred.
GANKER_INTERNAL_SUBNET=172.30.0.0/24
GANKER_NGINX_IP=172.30.0.10

# Límites independientes por IP y correo (un solo worker; estado en memoria).
LOGIN_RATE_LIMIT_ENABLED=true
REGISTRATION_RATE_LIMIT_ENABLED=true
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=3
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
FORGOT_PASSWORD_RATE_LIMIT_ENABLED=true
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# --- 3. Usuario Owner Inicial (Único dato que se crea al levantar producción) ---
INITIAL_OWNER_NAME=Administrador Principal
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_EMAIL=tu_email_real@gankerweb.app
INITIAL_OWNER_PASSWORD=CAMBIAR_POR_PASSWORD_FUERTE_DEL_OWNER

# --- 4. Correo Electrónico (Recuperación de contraseña) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_EMAIL_FROM="Ganker <noreply@gankerweb.app>"

RESEND_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM="Ganker <noreply@gankerweb.app>"

# --- 5. API de Riot Games ---
RIOT_API_KEY=

# --- 6. OAuth2 / Login Federado (Recuerda registrar estos Redirect URIs en cada consola) ---
# Discord Developer Portal -> OAuth2 -> Redirects:
#   1) https://gankerweb.app/app/discord/callback
#   2) https://gankerweb.app/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://gankerweb.app/app/discord/callback
DISCORD_AUTH_REDIRECT_URI=https://gankerweb.app/auth/callback/discord

# Google Cloud Console -> Credentials -> Authorized redirect URIs:
#   https://gankerweb.app/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gankerweb.app/auth/callback/google

# Twitch Developer Console -> OAuth Redirect URLs:
#   https://gankerweb.app/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://gankerweb.app/auth/callback/twitch

# Steam Web API Key:
STEAM_API_KEY=
STEAM_REDIRECT_URI=https://gankerweb.app/auth/callback/steam
STEAM_REALM=https://gankerweb.app
