# Entorno ("development" o "production")
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SEED_DEMO_DATA=true

# Límites independientes por IP y correo; ventanas en segundos.
LOGIN_RATE_LIMIT_ENABLED=true
REGISTRATION_RATE_LIMIT_ENABLED=true
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=3
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
FORGOT_PASSWORD_RATE_LIMIT_ENABLED=true
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600

# Espera entre reportes del mismo denunciante al mismo jugador (estado en BD).
PLAYER_REPORT_COOLDOWN_SECONDS=86400

# Usuario owner inicial (usado en producción cuando SEED_DEMO_DATA=false)
INITIAL_OWNER_NAME=
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=

#Json web token secret key
JWT_SECRET_KEY=

# DATABASE_URL=

# CLAVES PARA RESTABLECER LA CONTRASEÑA CON RESEND.COM
RESEND_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=

# CLAVES PARA RESTABLECER CONTRASEÑA USANDO SMTP DE GMAIL
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_EMAIL_FROM=

# CLAVE GENERAL PARA AMBOS METODOS
FRONTEND_URL=

# DISCORD OAUTH2 (Perfil + Login federado)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/app/discord/callback
DISCORD_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback/discord

# GOOGLE OAUTH2 (Login federado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# TWITCH OAUTH2 (Login federado)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:5173/auth/callback/twitch

# STEAM OPENID 2.0 + WEB API (Login federado)
STEAM_API_KEY=
STEAM_REDIRECT_URI=http://localhost:5173/auth/callback/steam
STEAM_REALM=http://localhost:5173
