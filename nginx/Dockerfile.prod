# ==============================================================================
# Stage 1: Compilar el bundle estático de producción del Frontend (Vite + React)
# ==============================================================================
FROM node:22-alpine AS frontend-builder

WORKDIR /app

# En producción detrás de Nginx (mismo origen), VITE_API_URL puede ser vacío ""
# o "https://gankerweb.app". Vacío permite que tanto gankerweb.app como
# www.gankerweb.app funcionen sin problemas de CORS/WSS.
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}

COPY Frontend/package*.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY Frontend/ ./
RUN npm run build

# ==============================================================================
# Stage 2: Servidor Nginx de Producción (Reverse Proxy + SPA + Media)
# ==============================================================================
FROM nginx:1.27-alpine

# Eliminar configuración por defecto y copiar la de producción
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx/prod.conf /etc/nginx/conf.d/default.conf

# Copiar los archivos estáticos compilados del Frontend
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Crear directorio para certificados SSL y medios
RUN mkdir -p /etc/nginx/certs /var/www/media

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
